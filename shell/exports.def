; The five entry points a COM in-process server must export, by their undecorated names.
;
; On 32-bit Windows the stdcall convention decorates symbols (_DllRegisterServer@0), and regsvr32
; looks the functions up by plain name; a .def file pins the exported names on both targets.
; PRIVATE: exported from the DLL but kept out of the import library, which is what the linker asks
; for with COM entry points -- nothing links against them, they are found by name at run time.
LIBRARY LikhiTextService
EXPORTS
    DllMain PRIVATE
    DllGetClassObject PRIVATE
    DllCanUnloadNow PRIVATE
    DllRegisterServer PRIVATE
    DllUnregisterServer PRIVATE
